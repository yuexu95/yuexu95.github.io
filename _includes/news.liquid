<div class="news" style="{% unless include.limit %}font-size: 1em;{% else %}font-size: 0.5em;{% endunless %} color: var(--global-text-color)">
  {% assign news_items = site.news | sort: 'date' | reverse %}
  {% if news_items.size > 0 %}
    {% if include.limit %}
      {% assign news_limit = page.announcements.limit | default: 5 %}
      {% assign news_items = news_items | limit: news_limit %}
    {% endif %}
    {% unless include.limit %}
      <!-- Full news page: publications-style two-column layout -->
      {% for item in news_items %}
        {% assign highlighted_title = item.title | replace: 'Yue Xu', '<span class="news-name-highlight">Yue Xu</span>' %}
        <div class="row news-item" style="margin-bottom: 2rem;">
          <div class="col-sm-12">
            <div style="display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.4rem;">
              <span style="white-space: nowrap; font-weight: normal;">
                {% if item.redirect %}
                  <a href="{{ item.redirect }}" target="_blank" style="color: inherit; text-decoration: underline">{{ item.date | date: '%b %Y' }}</a>
                {% elsif item.permalink %}
                  <a href="{{ item.url | relative_url }}" style="color: inherit; text-decoration: underline">{{ item.date | date: '%b %Y' }}</a>
                {% else %}
                  {{ item.date | date: '%b %Y' }}
                {% endif %}
              </span>
              <span>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | replace: 'Yue Xu', '<span class="news-name-highlight">Yue Xu</span>' | emojify }}
                {% else %}
                  {{ highlighted_title }}
                {% endif %}
              </span>
              {% if item.location %}
                <span style="white-space: nowrap; color: var(--global-text-color)">&mdash; {{ item.location }}</span>
              {% endif %}
            </div>
            {% unless item.inline %}
              {{ item.content }}
            {% endunless %}
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- Homepage: compact table view -->
      <div
        class="table-responsive"
        {% if page.announcements.scrollable and site.news.size > 3 %}
          style="max-height: 60vw"
        {% endif %}
      >
        <table class="table table-sm table-borderless" style="border-spacing: 0; border-collapse: collapse">
          {% for item in news_items %}
            <tr>
              <th scope="row" style="width: fit-content; white-space: nowrap; padding-right: 1rem; font-weight: normal">
                {% if item.redirect %}
                  <a href="{{ item.redirect }}" target="_blank" style="color: inherit; text-decoration: underline">{{ item.date | date: '%b %Y' }}</a>
                {% elsif item.inline == false or item.inline == null %}
                  <a href="{{ item.url | relative_url }}" style="color: inherit; text-decoration: underline">{{ item.date | date: '%b %Y' }}</a>
                {% else %}
                  {{ item.date | date: '%b %Y' }}
                {% endif %}
              </th>
              <td>
                {% assign highlighted_title = item.title | replace: 'Yue Xu', '<span class="news-name-highlight">Yue Xu</span>' %}
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | replace: 'Yue Xu', '<span class="news-name-highlight">Yue Xu</span>' | emojify }}
                {% else %}
                  {{ highlighted_title }}
                {% endif %}
              </td>
              {% if item.location %}
                <td class="text-end" style="white-space: nowrap; font-size: 1.50em; color: var(--global-text-color)">&mdash; {{ item.location }}</td>
              {% else %}
                <td></td>
              {% endif %}
            </tr>
          {% endfor %}
        </table>
      </div>
    {% endunless %}
  {% else %}
    <p>No news yet.</p>
  {% endif %}
</div>
