<div class="news" style="font-size: 0.5em">
  {% assign news_items = site.news | sort: 'date' | reverse %}
  {% if news_items.size > 0 %}
    {% if include.limit %}
      {% assign news_limit = page.announcements.limit | default: 5 %}
      {% assign news_items = news_items | limit: news_limit %}
    {% endif %}
    <div
      class="table-responsive"
      {% if page.announcements.scrollable and site.news.size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% for item in news_items %}
          <tr>
            <th scope="row" style="width: fit-content; white-space: nowrap; padding-right: 1rem; font-weight: normal">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% elsif item.redirect %}
                <a class="news-title" href="{{ item.redirect }}" target="_blank">{{ item.title }}</a>
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
              {% if item.location %}
                <span class="text-muted" style="font-size: 0.85em"> &mdash; {{ item.location }}</span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news yet.</p>
  {% endif %}
</div>
