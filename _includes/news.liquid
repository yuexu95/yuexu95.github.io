<div class="news" style="{% unless include.limit %}font-size: 1em;{% else %}font-size: 0.5em;{% endunless %} color: var(--global-text-color)">
  {% assign news_items = site.news | sort: 'date' | reverse %}
  {% if news_items.size > 0 %}
    {% if include.limit %}
      {% assign news_limit = page.announcements.limit | default: 5 %}
      {% assign news_items = news_items | limit: news_limit %}
    {% endif %}
    {% unless include.limit %}
      <!-- Full news page: two-column list (date | text) -->
      <div class="news-list">
        {% for item in news_items %}
          <div class="news-item">
            <div class="news-date">
              {% if item.redirect %}
                <a href="{{ item.redirect }}" target="_blank">{{ item.date | date: '%b %Y' }}</a>
              {% elsif item.permalink %}
                <a href="{{ item.url | relative_url }}">{{ item.date | date: '%b %Y' }}</a>
              {% else %}
                {{ item.date | date: '%b %Y' }}
              {% endif %}
            </div>
            <div class="news-text">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                {{ item.title }}
              {% endif %}
              {% if item.location %}
                <div class="news-location">{{ item.location }}</div>
              {% endif %}
              {% unless item.inline %}
                {{ item.content }}
              {% endunless %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <!-- Homepage: compact table view -->
      <div
        class="table-responsive"
        {% if page.announcements.scrollable and site.news.size > 3 %}
          style="max-height: 60vw"
        {% endif %}
      >
        <table class="table table-sm table-borderless" style="border-spacing: 0; border-collapse: collapse">
          {% for item in news_items %}
            <tr>
              <th scope="row" class="news-date" style="width: fit-content; white-space: nowrap; padding-right: 1rem">
                {% if item.redirect %}
                  <a href="{{ item.redirect }}" target="_blank">{{ item.date | date: '%b %Y' }}</a>
                {% elsif item.inline == false or item.inline == null %}
                  <a href="{{ item.url | relative_url }}">{{ item.date | date: '%b %Y' }}</a>
                {% else %}
                  {{ item.date | date: '%b %Y' }}
                {% endif %}
              </th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  {{ item.title }}
                {% endif %}
                {% if item.location %}
                  <div class="news-location">{{ item.location }}</div>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </table>
      </div>
    {% endunless %}
  {% else %}
    <p>No news yet.</p>
  {% endif %}
</div>
